#!/usr/bin/env bash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Zeabur Backend — Pre-Push Hook
# Scans secrets, runs golangci-lint with auto-fix (and auto-commits
# fixes), then compiles only the cmd/ services affected by the push.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

set -u

# Colors
_CLI_RED='\033[0;31m'
_CLI_GREEN='\033[0;32m'
_CLI_YELLOW='\033[0;33m'
_CLI_BLUE='\033[0;34m'
_CLI_PURPLE='\033[0;35m'
_CLI_CYAN='\033[0;36m'
_CLI_GRAY='\033[0;90m'
_CLI_NC='\033[0m'

_CLI_WIDTH="${COLUMNS:-$( (tput cols </dev/tty) 2>/dev/null || tput cols 2>/dev/null || echo 80)}"

_CLI_CHECK="${_CLI_GREEN}[✓]${_CLI_NC}"
_CLI_CROSS="${_CLI_RED}[✗]${_CLI_NC}"
_CLI_WARN="${_CLI_YELLOW}[!]${_CLI_NC}"
_CLI_INFO="${_CLI_CYAN}[i]${_CLI_NC}"

log_info()    { echo -e "$_CLI_INFO $1"; }
log_success() { echo -e "$_CLI_CHECK $1"; }
log_warn()    { echo -e "$_CLI_WARN $1"; }
log_error()   { echo -e "$_CLI_CROSS $1"; }

print_divider() {
  local color="${1:-$_CLI_PURPLE}" label="${2:-}"
  local width="$_CLI_WIDTH"
  if [[ -n "$label" ]]; then
    local padding=$((width - ${#label} - 6))
    [[ $padding -lt 0 ]] && padding=0
    local fill
    printf -v fill '%*s' "$padding" ''
    printf '%b━━━━[%s]%s%b\n' "$color" "$label" "${fill// /━}" "$_CLI_NC"
  else
    local fill
    printf -v fill '%*s' "$width" ''
    printf '%b%s%b\n' "$color" "${fill// /━}" "$_CLI_NC"
  fi
}

# ── Read push refs from stdin ─────────────────────────────────────
declare -a _PUSH_LOCAL_SHAS=()
declare -a _PUSH_REMOTE_SHAS=()

while IFS=' ' read -r _local_ref _local_sha _remote_ref _remote_sha; do
  [[ -z "$_local_ref" ]] && continue
  _PUSH_LOCAL_SHAS+=("$_local_sha")
  _PUSH_REMOTE_SHAS+=("$_remote_sha")
done

# Detect remote default branch; fall back to "main"
DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
DEFAULT_BRANCH="${DEFAULT_BRANCH:-main}"
ZERO_SHA="0000000000000000000000000000000000000000"

# get_push_range <local_sha> <remote_sha>
# Prints the commit range being pushed for a single ref.
# Prints nothing for branch deletions (all-zeros local SHA).
get_push_range() {
  local local_sha="$1" remote_sha="$2"

  [[ "$local_sha" == "$ZERO_SHA" ]] && return

  if [[ -n "$remote_sha" && "$remote_sha" != "$ZERO_SHA" ]]; then
    echo "${remote_sha}..${local_sha}"
  else
    local base
    base=$(git merge-base "$local_sha" "origin/${DEFAULT_BRANCH}" 2>/dev/null || true)
    if [[ -n "$base" ]]; then
      echo "${base}..${local_sha}"
    else
      echo "${local_sha}~20..${local_sha}"
    fi
  fi
}

TOTAL_STEPS=4

format_duration() {
  local total_s="$1"
  if (( total_s >= 60 )); then
    printf '%dm %ds' $((total_s / 60)) $((total_s % 60))
  else
    printf '%ds' "$total_s"
  fi
}

declare -a _STEP_NAMES=()
declare -a _STEP_DURATIONS=()

run_step() {
  local step_num="$1"
  local step_name="$2"
  local step_cmd="$3"
  local tmp_out
  tmp_out=$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXX")

  printf "${_CLI_GRAY}[·]${_CLI_NC} ${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name}..."

  local start_ts end_ts elapsed
  start_ts=$(date +%s)

  if eval "$step_cmd" >"$tmp_out" 2>&1; then
    end_ts=$(date +%s)
    elapsed=$((end_ts - start_ts))
    _STEP_NAMES+=("$step_name")
    _STEP_DURATIONS+=("$elapsed")
    printf "\r${_CLI_CHECK} ${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name} ${_CLI_GRAY}(%s)${_CLI_NC}\n" "$(format_duration $elapsed)"
    rm -f "$tmp_out"
    return 0
  else
    end_ts=$(date +%s)
    elapsed=$((end_ts - start_ts))
    _STEP_NAMES+=("$step_name")
    _STEP_DURATIONS+=("$elapsed")
    printf "\n\n"
    cat "$tmp_out"
    rm -f "$tmp_out"
    echo ""
    log_error "${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name} ${_CLI_RED}failed${_CLI_NC} ${_CLI_GRAY}($(format_duration $elapsed))${_CLI_NC}"
    echo ""
    log_info "Fix the errors above, then try pushing again."
    echo ""
    print_divider "$_CLI_RED"
    echo ""
    return 1
  fi
}

# ── Detect and regenerate proto/graphql if changed ────────────────
detect_and_regenerate_codegen() {
  local i range changed_files
  local has_proto has_graphql

  for i in "${!_PUSH_LOCAL_SHAS[@]}"; do
    range=$(get_push_range "${_PUSH_LOCAL_SHAS[$i]}" "${_PUSH_REMOTE_SHAS[$i]}")
    [[ -z "$range" ]] && continue
    changed_files=$(git diff --name-only "$range" 2>/dev/null)

    if echo "$changed_files" | grep -q 'api/proto/.*\.proto$'; then
      has_proto=1
    fi
    if echo "$changed_files" | grep -q '\.graphqls$'; then
      has_graphql=1
    fi
  done

  if [[ "${has_proto:-0}" == "1" ]]; then
    echo "Proto files changed; regenerating gRPC code..."
    make grpc || return 1
    if git diff --quiet; then
      log_info "Generated proto code unchanged"
    else
      log_info "Generated proto code changed; staging for commit"
      git add pkg/proto/
      git commit -m "chore: regenerate proto code" || true
      log_warn "Proto regen committed. Push again to include it."
      return 1
    fi
  fi

  if [[ "${has_graphql:-0}" == "1" ]]; then
    echo "GraphQL schema changed; regenerating GraphQL code..."
    export GOPROXY="${GOPROXY:-https://goproxy.io,direct}"
    make graphql || return 1
    if git diff --quiet; then
      log_info "Generated GraphQL code unchanged"
    else
      log_info "Generated GraphQL code changed; staging for commit"
      git add internal/gateway/generated/ internal/shared/generated/
      git commit -m "chore: regenerate GraphQL code" || true
      log_warn "GraphQL regen committed. Push again to include it."
      return 1
    fi
  fi
}

# ── Step 1: gitleaks across pushed commit range(s) ───────────────
check_gitleaks() {
  local i range
  for i in "${!_PUSH_LOCAL_SHAS[@]}"; do
    range=$(get_push_range "${_PUSH_LOCAL_SHAS[$i]}" "${_PUSH_REMOTE_SHAS[$i]}")
    [[ -z "$range" ]] && continue
    echo "Scanning range: ${range}"
    gitleaks detect --log-opts="$range" --no-banner --verbose || return 1
  done
}

# ── Step 2: golangci-lint --fix + fmt + auto-commit + re-check ───
run_lint_with_autofix() {
  local rev="origin/${DEFAULT_BRANCH}"

  # If origin/<default> is unknown locally, fall back to HEAD~1 to keep --new-from-rev usable.
  if ! git rev-parse --verify --quiet "$rev" >/dev/null 2>&1; then
    rev="HEAD~1"
  fi

  echo "Running golangci-lint fmt (formatters: goimports)..."
  golangci-lint fmt ./... || true

  echo "Running golangci-lint --fix --new-from-rev=${rev}..."
  golangci-lint run --fix --new-from-rev="$rev" ./... || true

  # If anything was auto-modified, commit only changed Go files (not untracked).
  local changed_files
  changed_files=$(git diff --name-only -- '*.go' 2>/dev/null || true)
  if [[ -n "$changed_files" ]]; then
    log_info "Auto-fix produced changes; committing as separate commit"
    echo "$changed_files" | xargs git add --
    git commit -m "style: auto-fix lint issues" || {
      log_error "Failed to create auto-fix commit"
      return 1
    }
    log_warn "Lint auto-fix committed. Push again to include it."
    return 1
  fi

  # Re-check without --fix to confirm nothing remains.
  echo "Re-running lint check (no --fix)..."
  golangci-lint run --new-from-rev="$rev" ./...
}

# ── Step 3: build only services affected by the pushed range(s) ──
collect_changed_paths() {
  local i range
  for i in "${!_PUSH_LOCAL_SHAS[@]}"; do
    range=$(get_push_range "${_PUSH_LOCAL_SHAS[$i]}" "${_PUSH_REMOTE_SHAS[$i]}")
    [[ -z "$range" ]] && continue
    git diff --name-only "$range" 2>/dev/null
  done
}

derive_build_targets() {
  local files="$1"
  local f svc

  {
    while IFS= read -r f; do
      [[ -z "$f" ]] && continue

      case "$f" in
        cmd/*)
          svc=$(echo "$f" | awk -F/ '{print $2}')
          [[ -n "$svc" ]] && echo "./cmd/${svc}"
          ;;
        internal/gateway/*)
          echo "./cmd/gateway"
          ;;
        internal/services/*)
          svc=$(echo "$f" | awk -F/ '{print $3}')
          if [[ -n "$svc" ]]; then
            if [[ -d "cmd/${svc}-service" ]]; then
              echo "./cmd/${svc}-service"
            elif [[ -d "cmd/${svc}" ]]; then
              echo "./cmd/${svc}"
            else
              echo "./cmd/gateway"
            fi
          fi
          ;;
        internal/shared/*)
          echo "./cmd/gateway"
          ;;
        api/proto/*)
          echo "./cmd/gateway"
          ;;
        pkg/*)
          echo "./cmd/gateway"
          ;;
      esac
    done <<< "$files"
  } | sort -u
}

run_affected_builds() {
  local changed
  changed=$(collect_changed_paths)
  if [[ -z "$changed" ]]; then
    log_info "No code changes detected in the push range; skipping build."
    return 0
  fi

  local targets
  targets=$(derive_build_targets "$changed")
  if [[ -z "$targets" ]]; then
    log_info "No cmd/ targets affected; skipping build."
    return 0
  fi

  echo "Affected build targets:"
  echo "$targets" | sed 's/^/  • /'
  echo ""

  local target
  while IFS= read -r target; do
    [[ -z "$target" ]] && continue
    if [[ ! -d "${target#./}" ]]; then
      log_warn "Target ${target} does not exist locally; skipping."
      continue
    fi
    echo "go build ${target}"
    go build "$target" || return 1
  done <<< "$targets"
}

# ── Main ──────────────────────────────────────────────────────────

echo ""
print_divider "$_CLI_PURPLE" "Pre-Push Checks"
echo ""

_HOOK_START_TS=$(date +%s)

run_step 1 "proto/graphql regeneration"          "detect_and_regenerate_codegen" || exit 1
run_step 2 "gitleaks (commit-range secret scan)" "check_gitleaks"      || exit 1
run_step 3 "golangci-lint --fix + re-check"      "run_lint_with_autofix" || exit 1
run_step 4 "go build (affected services)"        "run_affected_builds" || exit 1

_HOOK_END_TS=$(date +%s)
_HOOK_TOTAL=$((_HOOK_END_TS - _HOOK_START_TS))

echo ""
log_success "All pre-push checks passed ${_CLI_GRAY}(total: $(format_duration $_HOOK_TOTAL))${_CLI_NC}"
echo ""

# ── Timing breakdown ──
printf "${_CLI_GRAY}  %-42s %s${_CLI_NC}\n" "Step" "Duration"
printf "${_CLI_GRAY}  %-42s %s${_CLI_NC}\n" "──────────────────────────────────────────" "────────"
for _i in "${!_STEP_NAMES[@]}"; do
  printf "${_CLI_GRAY}  %-42s %s${_CLI_NC}\n" "${_STEP_NAMES[$_i]}" "$(format_duration ${_STEP_DURATIONS[$_i]})"
done
echo ""

print_divider "$_CLI_PURPLE"
echo ""
