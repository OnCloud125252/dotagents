#!/usr/bin/env bash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Zeabur Backend — Post-Merge Hook
# Automatically syncs generated code and dependencies after a merge:
#   • go mod download   (if go.mod/go.sum changed)
#   • make grpc         (if *.proto changed)
#   • make graphql      (if *.graphqls changed)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

set -u

# Colors
_CLI_RED='\033[0;31m'
_CLI_GREEN='\033[0;32m'
_CLI_YELLOW='\033[0;33m'
_CLI_CYAN='\033[0;36m'
_CLI_GRAY='\033[0;90m'
_CLI_PURPLE='\033[0;35m'
_CLI_NC='\033[0m'

_CLI_WIDTH="${COLUMNS:-$( (tput cols </dev/tty) 2>/dev/null || tput cols 2>/dev/null || echo 80)}"

_CLI_CHECK="${_CLI_GREEN}[✓]${_CLI_NC}"
_CLI_CROSS="${_CLI_RED}[✗]${_CLI_NC}"
_CLI_SKIP="${_CLI_GRAY}[–]${_CLI_NC}"
_CLI_INFO="${_CLI_CYAN}[i]${_CLI_NC}"

log_info()    { echo -e "$_CLI_INFO $1"; }
log_success() { echo -e "$_CLI_CHECK $1"; }
log_error()   { echo -e "$_CLI_CROSS $1"; }
log_skip()    { echo -e "$_CLI_SKIP $1"; }

print_divider() {
  local color="${1:-$_CLI_PURPLE}" label="${2:-}"
  local width="$_CLI_WIDTH"
  if [[ -n "$label" ]]; then
    local padding=$((width - ${#label} - 6))
    [[ $padding -lt 0 ]] && padding=0
    local fill
    printf -v fill '%*s' "$padding" ''
    printf '%b━━━━[%s]%s%b\n' "$color" "$label" "${fill// /━}" "$_CLI_NC"
  else
    local fill
    printf -v fill '%*s' "$width" ''
    printf '%b%s%b\n' "$color" "${fill// /━}" "$_CLI_NC"
  fi
}

# ── Detect changed files between pre-merge and post-merge ────────
CHANGED_FILES=$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)

if [[ -z "$CHANGED_FILES" ]]; then
  exit 0
fi

HAS_GO_MOD=false
HAS_PROTO=false
HAS_GRAPHQLS=false

while IFS= read -r f; do
  case "$f" in
    go.mod|go.sum)                          HAS_GO_MOD=true ;;
    api/proto/*.proto|api/proto/**/*.proto)  HAS_PROTO=true ;;
    *.graphqls)                             HAS_GRAPHQLS=true ;;
  esac
done <<< "$CHANGED_FILES"

# Nothing to do if no relevant files changed
if ! $HAS_GO_MOD && ! $HAS_PROTO && ! $HAS_GRAPHQLS; then
  exit 0
fi

STEP=0
TOTAL=0
$HAS_GO_MOD    && ((TOTAL++))
$HAS_PROTO     && ((TOTAL++))
$HAS_GRAPHQLS  && ((TOTAL++))

echo ""
print_divider "$_CLI_PURPLE" "Post-Merge Sync"
echo ""

FAILED=false

run_step() {
  local step_name="$1"
  local step_cmd="$2"
  ((STEP++))
  local tmp_out
  tmp_out=$(mktemp "${TMPDIR:-/tmp}/post-merge.XXXXXX")

  printf "${_CLI_GRAY}[·]${_CLI_NC} ${_CLI_GRAY}[${STEP}/${TOTAL}]${_CLI_NC} ${step_name}..."

  if eval "$step_cmd" >"$tmp_out" 2>&1; then
    printf "\r${_CLI_CHECK} ${_CLI_GRAY}[${STEP}/${TOTAL}]${_CLI_NC} ${step_name}\n"
    rm -f "$tmp_out"
    return 0
  else
    printf "\n\n"
    cat "$tmp_out"
    rm -f "$tmp_out"
    echo ""
    log_error "${_CLI_GRAY}[${STEP}/${TOTAL}]${_CLI_NC} ${step_name} ${_CLI_RED}failed${_CLI_NC}"
    echo ""
    log_info "You may need to run this manually or check ${_CLI_CYAN}scripts/setup-hooks.sh${_CLI_NC}"
    FAILED=true
    return 1
  fi
}

# ── 1. Go modules ────────────────────────────────────────────────
if $HAS_GO_MOD; then
  run_step "go mod download" "go mod download" || true
fi

# ── 2. gRPC codegen ──────────────────────────────────────────────
if $HAS_PROTO; then
  run_step "make grpc" "make grpc" || true
fi

# ── 3. GraphQL codegen ───────────────────────────────────────────
if $HAS_GRAPHQLS; then
  run_step "make graphql" 'GOPROXY=${GOPROXY:-https://goproxy.io,direct} make graphql' || true
fi

echo ""
if $FAILED; then
  log_error "Some post-merge steps failed — see errors above"
else
  log_success "Post-merge sync complete"
fi
echo ""
print_divider "$_CLI_PURPLE"
echo ""
