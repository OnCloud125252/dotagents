#!/usr/bin/env bash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Pre-Push Hook — bun + biome stack
#   1. gitleaks (commit range, if .gitleaks.toml present)
#   2. bun run check                  (biome lint + format check, no --write)
#   3. bunx tsc --noEmit              (TypeScript type check)
#   4. bun test                       (only if "test" script defined)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

set -u

_CLI_RED='\033[0;31m'
_CLI_GREEN='\033[0;32m'
_CLI_YELLOW='\033[0;33m'
_CLI_PURPLE='\033[0;35m'
_CLI_CYAN='\033[0;36m'
_CLI_GRAY='\033[0;90m'
_CLI_NC='\033[0m'

_CLI_WIDTH="${COLUMNS:-$( (tput cols </dev/tty) 2>/dev/null || tput cols 2>/dev/null || echo 80)}"

_CLI_CHECK="${_CLI_GREEN}[✓]${_CLI_NC}"
_CLI_CROSS="${_CLI_RED}[✗]${_CLI_NC}"
_CLI_WARN="${_CLI_YELLOW}[!]${_CLI_NC}"
_CLI_INFO="${_CLI_CYAN}[i]${_CLI_NC}"

log_info()    { echo -e "$_CLI_INFO $1"; }
log_success() { echo -e "$_CLI_CHECK $1"; }
log_warn()    { echo -e "$_CLI_WARN $1"; }
log_error()   { echo -e "$_CLI_CROSS $1"; }

print_divider() {
  local color="${1:-$_CLI_PURPLE}" label="${2:-}"
  local width="$_CLI_WIDTH"
  if [[ -n "$label" ]]; then
    local padding=$((width - ${#label} - 6))
    [[ $padding -lt 0 ]] && padding=0
    local fill
    printf -v fill '%*s' "$padding" ''
    printf '%b━━━━[%s]%s%b\n' "$color" "$label" "${fill// /━}" "$_CLI_NC"
  else
    local fill
    printf -v fill '%*s' "$width" ''
    printf '%b%s%b\n' "$color" "${fill// /━}" "$_CLI_NC"
  fi
}

# ── Read push refs from stdin (gitleaks needs the range) ─────────
declare -a _PUSH_LOCAL_SHAS=()
declare -a _PUSH_REMOTE_SHAS=()

while IFS=' ' read -r _local_ref _local_sha _remote_ref _remote_sha; do
  [[ -z "$_local_ref" ]] && continue
  _PUSH_LOCAL_SHAS+=("$_local_sha")
  _PUSH_REMOTE_SHAS+=("$_remote_sha")
done

DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
DEFAULT_BRANCH="${DEFAULT_BRANCH:-main}"
ZERO_SHA="0000000000000000000000000000000000000000"

get_push_range() {
  local local_sha="$1" remote_sha="$2"
  [[ "$local_sha" == "$ZERO_SHA" ]] && return
  if [[ -n "$remote_sha" && "$remote_sha" != "$ZERO_SHA" ]]; then
    echo "${remote_sha}..${local_sha}"
  else
    local base
    base=$(git merge-base "$local_sha" "origin/${DEFAULT_BRANCH}" 2>/dev/null || true)
    if [[ -n "$base" ]]; then
      echo "${base}..${local_sha}"
    else
      echo "${local_sha}~20..${local_sha}"
    fi
  fi
}

# ── Detect optional steps ────────────────────────────────────────
HAS_GITLEAKS_CFG=false
[[ -f ".gitleaks.toml" ]] && HAS_GITLEAKS_CFG=true

HAS_TEST_SCRIPT=false
if [[ -f "package.json" ]] && command -v jq >/dev/null 2>&1; then
  if [[ "$(jq -r '.scripts.test // empty' package.json)" != "" ]]; then
    HAS_TEST_SCRIPT=true
  fi
fi

TOTAL_STEPS=2 # check + tsc are always present
$HAS_GITLEAKS_CFG && ((TOTAL_STEPS++))
$HAS_TEST_SCRIPT && ((TOTAL_STEPS++))

format_duration() {
  local total_s="$1"
  if (( total_s >= 60 )); then
    printf '%dm %ds' $((total_s / 60)) $((total_s % 60))
  else
    printf '%ds' "$total_s"
  fi
}

declare -a _STEP_NAMES=()
declare -a _STEP_DURATIONS=()

run_step() {
  local step_num="$1"
  local step_name="$2"
  local step_cmd="$3"
  local tmp_out
  tmp_out=$(mktemp "${TMPDIR:-/tmp}/pre-push.XXXXXX")

  printf "${_CLI_GRAY}[·]${_CLI_NC} ${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name}..."

  local start_ts end_ts elapsed
  start_ts=$(date +%s)

  if eval "$step_cmd" >"$tmp_out" 2>&1; then
    end_ts=$(date +%s)
    elapsed=$((end_ts - start_ts))
    _STEP_NAMES+=("$step_name"); _STEP_DURATIONS+=("$elapsed")
    printf "\r${_CLI_CHECK} ${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name} ${_CLI_GRAY}(%s)${_CLI_NC}\n" "$(format_duration $elapsed)"
    rm -f "$tmp_out"
    return 0
  else
    end_ts=$(date +%s)
    elapsed=$((end_ts - start_ts))
    _STEP_NAMES+=("$step_name"); _STEP_DURATIONS+=("$elapsed")
    printf "\n\n"
    cat "$tmp_out"
    rm -f "$tmp_out"
    echo ""
    log_error "${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name} ${_CLI_RED}failed${_CLI_NC} ${_CLI_GRAY}($(format_duration $elapsed))${_CLI_NC}"
    echo ""
    log_info "Fix the errors above, then try pushing again."
    echo ""
    print_divider "$_CLI_RED"
    echo ""
    return 1
  fi
}

check_gitleaks() {
  local i range
  for i in "${!_PUSH_LOCAL_SHAS[@]}"; do
    range=$(get_push_range "${_PUSH_LOCAL_SHAS[$i]}" "${_PUSH_REMOTE_SHAS[$i]}")
    [[ -z "$range" ]] && continue
    echo "Scanning range: ${range}"
    gitleaks detect --log-opts="$range" --no-banner --verbose || return 1
  done
}

# ── Main ──────────────────────────────────────────────────────────

echo ""
print_divider "$_CLI_PURPLE" "Pre-Push Checks"
echo ""

_HOOK_START_TS=$(date +%s)

step=1
if $HAS_GITLEAKS_CFG; then
  run_step "$step" "gitleaks (commit-range secret scan)" "check_gitleaks" || exit 1
  ((step++))
fi

run_step "$step" "bun run check (biome)"           "bun run check"        || exit 1
((step++))
run_step "$step" "tsc --noEmit (type check)"       "bunx tsc --noEmit"    || exit 1
((step++))

if $HAS_TEST_SCRIPT; then
  run_step "$step" "bun test"                      "bun test"             || exit 1
fi

_HOOK_END_TS=$(date +%s)
_HOOK_TOTAL=$((_HOOK_END_TS - _HOOK_START_TS))

echo ""
log_success "All pre-push checks passed ${_CLI_GRAY}(total: $(format_duration $_HOOK_TOTAL))${_CLI_NC}"
echo ""

printf "${_CLI_GRAY}  %-42s %s${_CLI_NC}\n" "Step" "Duration"
printf "${_CLI_GRAY}  %-42s %s${_CLI_NC}\n" "──────────────────────────────────────────" "────────"
for _i in "${!_STEP_NAMES[@]}"; do
  printf "${_CLI_GRAY}  %-42s %s${_CLI_NC}\n" "${_STEP_NAMES[$_i]}" "$(format_duration ${_STEP_DURATIONS[$_i]})"
done
echo ""

print_divider "$_CLI_PURPLE"
echo ""
