#!/usr/bin/env bash

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Pre-Commit Hook — bun + biome stack
# Blocks secrets (if .gitleaks.toml present) and runs biome check --write
# on staged files; fixes are re-staged into the current commit.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

set -u

_CLI_RED='\033[0;31m'
_CLI_GREEN='\033[0;32m'
_CLI_YELLOW='\033[0;33m'
_CLI_CYAN='\033[0;36m'
_CLI_GRAY='\033[0;90m'
_CLI_PURPLE='\033[0;35m'
_CLI_NC='\033[0m'

_CLI_WIDTH="${COLUMNS:-$( (tput cols </dev/tty) 2>/dev/null || tput cols 2>/dev/null || echo 80)}"

_CLI_CHECK="${_CLI_GREEN}[✓]${_CLI_NC}"
_CLI_CROSS="${_CLI_RED}[✗]${_CLI_NC}"
_CLI_WARN="${_CLI_YELLOW}[!]${_CLI_NC}"
_CLI_INFO="${_CLI_CYAN}[i]${_CLI_NC}"

log_info()    { echo -e "$_CLI_INFO $1"; }
log_success() { echo -e "$_CLI_CHECK $1"; }
log_warn()    { echo -e "$_CLI_WARN $1"; }
log_error()   { echo -e "$_CLI_CROSS $1"; }

print_divider() {
  local color="${1:-$_CLI_PURPLE}" label="${2:-}"
  local width="$_CLI_WIDTH"
  if [[ -n "$label" ]]; then
    local padding=$((width - ${#label} - 6))
    [[ $padding -lt 0 ]] && padding=0
    local fill
    printf -v fill '%*s' "$padding" ''
    printf '%b━━━━[%s]%s%b\n' "$color" "$label" "${fill// /━}" "$_CLI_NC"
  else
    local fill
    printf -v fill '%*s' "$width" ''
    printf '%b%s%b\n' "$color" "${fill// /━}" "$_CLI_NC"
  fi
}

# Determine total steps based on optional gitleaks
HAS_GITLEAKS_CFG=false
[[ -f ".gitleaks.toml" ]] && HAS_GITLEAKS_CFG=true
TOTAL_STEPS=1
$HAS_GITLEAKS_CFG && ((TOTAL_STEPS++))

run_step() {
  local step_num="$1"
  local step_name="$2"
  local step_cmd="$3"
  local tmp_out
  tmp_out=$(mktemp "${TMPDIR:-/tmp}/pre-commit.XXXXXX")

  printf "${_CLI_GRAY}[·]${_CLI_NC} ${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name}..."

  if eval "$step_cmd" >"$tmp_out" 2>&1; then
    printf "\r${_CLI_CHECK} ${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name}\n"
    rm -f "$tmp_out"
    return 0
  else
    printf "\n\n"
    cat "$tmp_out"
    rm -f "$tmp_out"
    echo ""
    log_error "${_CLI_GRAY}[${step_num}/${TOTAL_STEPS}]${_CLI_NC} ${step_name} ${_CLI_RED}failed${_CLI_NC}"
    echo ""
    log_info "Fix the errors above, then try again."
    echo ""
    print_divider "$_CLI_RED"
    echo ""
    return 1
  fi
}

# ── Snapshot / re-stage helpers ──────────────────────────────────
# After biome --write, re-stage only originally-staged files so fixes land
# in the current commit. Unstaged files stay untouched.
_staged_js_files=""

snapshot_staged_js_files() {
  _staged_js_files=$(git diff --cached --name-only --diff-filter=ACMR \
    -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.json' '*.jsonc' \
    2>/dev/null || true)
}

apply_biome_to_staged() {
  [[ -z "$_staged_js_files" ]] && return 0

  # biome --staged reads index, writes to working tree. Run unconditionally so
  # fixes apply; ignore non-fixable warnings (re-check happens in pre-push).
  bunx biome check --write --staged --no-errors-on-unmatched 2>&1 || true
}

stage_biome_fixes() {
  [[ -z "$_staged_js_files" ]] && return 0

  echo "$_staged_js_files" | xargs -I{} -- git add -- {} || {
    log_error "Failed to re-stage biome fixes"
    return 1
  }
  log_info "biome fixes staged into your commit"
}

# ── Main ──────────────────────────────────────────────────────────

echo ""
print_divider "$_CLI_PURPLE" "Pre-Commit Checks"
echo ""

step=1
if $HAS_GITLEAKS_CFG; then
  run_step "$step" "gitleaks (staged secret scan)" \
    "gitleaks protect --staged --no-banner" || exit 1
  ((step++))
fi

snapshot_staged_js_files
run_step "$step" "biome check --write (staged)" "apply_biome_to_staged" || exit 1
stage_biome_fixes || exit 1

echo ""
log_success "All pre-commit checks passed"
echo ""
print_divider "$_CLI_PURPLE"
echo ""
